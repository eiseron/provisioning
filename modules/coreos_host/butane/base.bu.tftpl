variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      groups:
        - sudo
        - wheel
      ssh_authorized_keys:
        - ${deploy_ssh_authorized_key}

storage:
  files:
    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      mode: 0600
      overwrite: true
      contents:
        inline: |
          PermitRootLogin no
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          ChallengeResponseAuthentication no
          AllowUsers core
          X11Forwarding no
          MaxAuthTries 3
          ClientAliveInterval 300
          ClientAliveCountMax 2

    - path: /etc/sysctl.d/99-hardening.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          net.ipv4.conf.all.rp_filter = 1
          net.ipv4.conf.default.rp_filter = 1
          net.ipv4.conf.all.accept_redirects = 0
          net.ipv4.conf.default.accept_redirects = 0
          net.ipv4.conf.all.send_redirects = 0
          net.ipv4.conf.default.send_redirects = 0
          net.ipv4.conf.all.accept_source_route = 0
          net.ipv6.conf.all.accept_redirects = 0
          net.ipv6.conf.all.accept_source_route = 0
          kernel.kptr_restrict = 2
          kernel.dmesg_restrict = 1
          kernel.yama.ptrace_scope = 1
          fs.protected_hardlinks = 1
          fs.protected_symlinks = 1

    - path: /etc/systemd/zram-generator.conf
      mode: 0644
      contents:
        inline: |
          [zram0]
          zram-size = min(ram, 2048)

    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: |
          ${hostname}
%{ if k3s_enabled ~}

    - path: /etc/rancher/k3s/config.yaml
      mode: 0600
      contents:
        inline: |
          write-kubeconfig-mode: "0640"
          tls-san:
%{ for san in k3s_tls_san ~}
            - ${san}
%{ endfor ~}

    - path: /etc/yum.repos.d/rancher-k3s-common.repo
      mode: 0644
      contents:
        inline: |
          [rancher-k3s-common-stable]
          name=Rancher K3s Common (stable)
          baseurl=https://rpm.rancher.io/k3s/stable/common/coreos/noarch
          enabled=1
          gpgcheck=1
          gpgkey=https://rpm.rancher.io/public.key
%{ endif ~}
%{ if luks_enabled ~}

  luks:
    - name: ${luks_name}
      device: ${luks_device}
      discard: true
      wipe_volume: ${luks_wipe}
      clevis:
        tang:
          - url: ${tang_url}
            thumbprint: ${tang_thumbprint}

  filesystems:
    - device: /dev/mapper/${luks_name}
      format: ext4
      path: ${luks_mount}
      label: crypt
      with_mount_unit: true
%{ endif ~}

systemd:
  units:
    - name: zincati.service
      dropins:
        - name: 10-reboot-window.conf
          contents: |
            [Service]
            Environment=ZINCATI_UPDATE_STRATEGY=periodic
%{ if k3s_enabled ~}

    - name: rpm-ostree-install-k3s-selinux.service
      enabled: true
      contents: |
        [Unit]
        Description=Layer k3s-selinux via rpm-ostree
        Wants=network-online.target
        After=network-online.target
        Before=k3s-install.service
        ConditionPathExists=!/var/lib/%N.done
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/rpm-ostree install --apply-live --allow-inactive --idempotent k3s-selinux
        ExecStart=/usr/bin/touch /var/lib/%N.done
        [Install]
        WantedBy=multi-user.target

    - name: k3s-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install the pinned k3s binary
        Wants=network-online.target
        After=network-online.target rpm-ostree-install-k3s-selinux.service
        ConditionPathExists=!/usr/local/bin/k3s
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/sh -c 'set -eu; cd /usr/local/bin; curl -fsSL -o k3s "https://github.com/k3s-io/k3s/releases/download/${k3s_version_url}/k3s"; curl -fsSL -o k3s.sha256 "https://github.com/k3s-io/k3s/releases/download/${k3s_version_url}/sha256sum-amd64.txt"; grep -E " k3s$" k3s.sha256 | sha256sum -c -; chmod 0755 k3s; rm -f k3s.sha256'
        [Install]
        WantedBy=multi-user.target

    - name: k3s.service
      enabled: true
      contents: |
        [Unit]
        Description=Lightweight Kubernetes
        Wants=network-online.target
        After=network-online.target k3s-install.service
        [Service]
        Type=notify
        ExecStart=/usr/local/bin/k3s server --config /etc/rancher/k3s/config.yaml
        Restart=always
        RestartSec=5s
        KillMode=process
        Delegate=yes
        [Install]
        WantedBy=multi-user.target
%{ endif ~}
