services:
  postgres:
    image: {{ postgres_shared_image }}
    container_name: {{ postgres_shared_container_name }}
    restart: unless-stopped
    command: ["postgres", "-c", "max_connections={{ postgres_shared_max_connections }}"]
    environment:
      POSTGRES_USER: {{ pg_shared_user }}
      POSTGRES_PASSWORD: {{ pg_shared_password }}
      POSTGRES_DB: postgres
    volumes:
      - {{ postgres_shared_volume }}:/var/lib/postgresql
    networks:
      - {{ postgres_shared_network }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ pg_shared_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  {{ postgres_shared_volume }}:

networks:
  {{ postgres_shared_network }}:
    external: true
