services:
  app:
    image: {{ preview_app_image }}
    container_name: {{ preview_app_name }}
    restart: unless-stopped
    env_file:
      - app.env
    networks:
      - {{ preview_app_traefik_network }}
      - {{ preview_app_postgres_network }}
{% if preview_app_healthcheck_path | length > 0 %}
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:{{ preview_app_port }}{{ preview_app_healthcheck_path }} || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ preview_app_traefik_network }}"
      - "traefik.http.routers.{{ preview_app_name }}.rule=Host(`{{ preview_app_host }}`)"
      - "traefik.http.routers.{{ preview_app_name }}.entrypoints={{ preview_app_entrypoint }}"
      - "traefik.http.routers.{{ preview_app_name }}.tls=true"
      - "traefik.http.services.{{ preview_app_name }}.loadbalancer.server.port={{ preview_app_port }}"

networks:
  {{ preview_app_traefik_network }}:
    external: true
  {{ preview_app_postgres_network }}:
    external: true
