concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ gitlab_runner_token }}"
  executor = "{{ gitlab_runner_executor }}"
{% if gitlab_runner_cache_s3_access_key | length > 0 %}
  [runners.cache]
    Type = "s3"
    Shared = {{ gitlab_runner_cache_shared | ternary("true", "false") }}
    [runners.cache.s3]
      ServerAddress = "{{ gitlab_runner_cache_s3_endpoint }}"
      AccessKey = "{{ gitlab_runner_cache_s3_access_key }}"
      SecretKey = "{{ gitlab_runner_cache_s3_secret_key }}"
      BucketName = "{{ gitlab_runner_cache_s3_bucket }}"
      BucketLocation = "{{ gitlab_runner_cache_s3_bucket_location }}"
{% endif %}
  [runners.docker]
    image = "{{ gitlab_runner_docker_image }}"
    pull_policy = {{ gitlab_runner_docker_pull_policy | to_json }}
    privileged = false
    volumes = ["/cache"]
    shm_size = 0
